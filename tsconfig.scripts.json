{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-scripts",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["scripts/*.ts"],
  "exclude": ["scripts/*.test.ts"]
}
