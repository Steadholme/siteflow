# SiteFlow local/runtime configuration example.
# Copy values into your deployment environment; do not commit real secrets.

# Set SITEFLOW_ENV=production or NODE_ENV=production in production.
SITEFLOW_ENV=development
# NODE_ENV=production

# Control-plane API.
DATABASE_URL=postgres://siteflow:siteflow_dev_password@127.0.0.1:5432/siteflow
SITEFLOW_API_PORT=8787
SITEFLOW_ARTIFACT_ROOT=/var/lib/siteflow/artifacts
# Stable host-visible directory for production evidence consumed at runtime.
# Point SITEFLOW_BACKUP_AUTOMATION_RUN_RECORD at the latest backup:automation run record.
# SITEFLOW_EVIDENCE_ROOT=/var/lib/siteflow/evidence
# SITEFLOW_BACKUP_AUTOMATION_RUN_RECORD=/var/lib/siteflow/evidence/backup-automation-run.json
SITEFLOW_PUBLIC_SCHEME=http
# SITEFLOW_BASE_DOMAIN=example.com
# SITEFLOW_ALLOWED_ORIGIN=https://siteflow.example.com
# Production Docker Compose requires digest-pinned runtime images.
# SITEFLOW_IMAGE=ghcr.io/siteflow/siteflow@sha256:replace-with-release-image-digest
# SITEFLOW_POSTGRES_IMAGE=postgres@sha256:replace-with-reviewed-postgres-image-digest
# Trust X-Forwarded-Host, X-Forwarded-Proto, and X-Forwarded-For only from
# expected reverse-proxy source addresses. Use loopback for same-host Nginx,
# private for RFC1918/unique-local ingress, or comma-separated IP/CIDR entries.
# Truthy values such as 1/true are treated as loopback. Direct exposure should
# leave this unset/false.
# SITEFLOW_TRUST_PROXY=loopback

# Authentication and secret sealing.
# Production must set SITEFLOW_APP_SECRET or SITEFLOW_SEALING_KEY.
# Placeholder and short values are rejected when SITEFLOW_ENV=production or NODE_ENV=production.
# Prefer SITEFLOW_APP_SECRET for new installs; keep SITEFLOW_SEALING_KEY only for legacy compatibility.
SITEFLOW_APP_SECRET=replace-with-at-least-32-random-bytes
# SITEFLOW_SEALING_KEY=replace-only-for-legacy-sealed-values
SITEFLOW_API_TOKEN=replace-with-random-api-token
# Operator sessions expire after their requested TTL and also after this idle window.
# Values must be integers from 60 to 86400 seconds. Default: 1800.
# SITEFLOW_OPERATOR_SESSION_IDLE_TIMEOUT_SECONDS=1800
# Optional bearer token for GET/HEAD /metrics scrapes.
# Keep /metrics behind a private scrape path or proxy allowlist even when this is set.
# Production requires this value unless SITEFLOW_ALLOW_UNAUTHENTICATED_METRICS=1 is explicitly accepted.
# SITEFLOW_METRICS_TOKEN=replace-with-random-metrics-token
# SITEFLOW_ALLOW_UNAUTHENTICATED_METRICS=0
# Same-process artifact functions are disabled by default in production.
# Enable only for local or emergency trusted-operator use; production release evidence rejects function artifacts until an isolated runner exists.
# SITEFLOW_ALLOW_SAME_PROCESS_FUNCTION_RUNTIME=0
# Configure only the signed git webhook providers you enable.
# SITEFLOW_GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret
# SITEFLOW_GITLAB_WEBHOOK_SECRET=replace-with-random-webhook-secret
# SITEFLOW_GITEA_WEBHOOK_SECRET=replace-with-random-webhook-secret
# SITEFLOW_GENERIC_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Do not set VITE_SITEFLOW_API_TOKEN for production browser bundles.
# Production browser bundles do not read browser storage token fallback unless this transition flag is explicit.
# VITE_SITEFLOW_ALLOW_BROWSER_TOKEN_FALLBACK=0

# Worker/runtime inputs.
# SITEFLOW_SOURCE_ROOT=/srv/siteflow/sources
# SITEFLOW_WORKER_ID=worker-1
# SITEFLOW_WORKER_POLL_INTERVAL_MS=5000
# Build steps and Git checkout/fetch commands fail instead of renewing leases forever.
# SITEFLOW_BUILD_STEP_TIMEOUT_MS=900000
# SITEFLOW_GIT_TIMEOUT_MS=300000
# Optional private repository SSH deploy-key path. Mount the key read-only and
# pin provider host keys when possible.
# SITEFLOW_GIT_SSH_KEY_PATH=/etc/siteflow/secrets/git-deploy-key
# SITEFLOW_GIT_KNOWN_HOSTS_PATH=/etc/siteflow/ssh/known_hosts
# Production installer Compose sets SITEFLOW_BUILD_RUNNER=docker and fails closed
# when the Docker CLI or Docker daemon is unavailable to the worker.
# SITEFLOW_BUILD_RUNNER=docker
# Production Docker workers require SITEFLOW_BUILD_IMAGE pinned to a digest.
# Tagged images require both SITEFLOW_BUILD_IMAGE_ALLOWLIST and explicit
# SITEFLOW_ALLOW_TAGGED_BUILD_IMAGE=1 acceptance.
# SITEFLOW_BUILD_IMAGE=node:20-bookworm-slim@sha256:replace-with-pinned-image-digest
# SITEFLOW_BUILD_IMAGE_ALLOWLIST=node:20-bookworm-slim
# SITEFLOW_ALLOW_TAGGED_BUILD_IMAGE=0
# Keep production build network disabled. Bridge networking is for trusted
# non-production cases and rejects sensitive build env keys.
# SITEFLOW_BUILD_NETWORK=none
# SITEFLOW_BUILD_MEMORY=1g
# SITEFLOW_BUILD_CPUS=2
# SITEFLOW_BUILD_PIDS_LIMIT=256
# SITEFLOW_BUILD_USER=1000:1000
# Build artifact publish hard limits. These apply after build output collection
# and again after precompressed .br/.gz variants are added.
SITEFLOW_BUILD_MAX_ARTIFACT_BYTES=536870912
SITEFLOW_BUILD_MAX_ARTIFACT_FILES=20000
# Build jobs fail before checkout/build when workspace, artifact, or temp storage
# has less free space than this threshold. Default is 2x max artifact bytes.
SITEFLOW_BUILD_MIN_FREE_BYTES=1073741824
# Prebuilt upload publish limits used by CLI and API upload paths.
SITEFLOW_PREBUILT_MAX_UPLOAD_BYTES=536870912
SITEFLOW_PREBUILT_MAX_FILES=20000
# SITEFLOW_DOCKER_CLEANUP_STALE_CONTAINERS=1
# SITEFLOW_DOCKER_STALE_CONTAINER_MAX_AGE_MS=3600000
# The generated Docker socket profile is for trusted single-host operators only;
# it is not a multi-tenant sandbox boundary.
