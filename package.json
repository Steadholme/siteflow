{
  "name": "siteflow-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "siteflow": "./dist-cli/cli/index.js"
  },
  "files": [
    "dist/",
    "dist-cli/",
    "dist-server/",
    "dist-worker/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean:build-artifacts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && npm run build:scripts && npm run build:cli && npm run build:server && npm run build:worker && vite build",
    "build:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "clean:build-artifacts": "node scripts/cleanBuildArtifacts.mjs",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:worker": "tsc -p tsconfig.worker.json",
    "api": "node dist-server/server/index.js",
    "worker": "node dist-worker/worker/index.js",
    "siteflow": "node dist-cli/cli/index.js",
    "rehearsal:postgres": "node scripts/runCompiledScript.mjs postgresRehearsalRunner.js",
    "rehearsal:docker-build": "node scripts/runCompiledScript.mjs dockerBuildRehearsalRunner.js",
    "backup:automation": "node scripts/runCompiledScript.mjs backupAutomationRun.js",
    "backup:evidence:compose": "node scripts/runCompiledScript.mjs backupEvidenceCompose.js",
    "backup:evidence": "node scripts/runCompiledScript.mjs backupEvidenceCheck.js",
    "observability:provisioning": "node scripts/runCompiledScript.mjs observabilityProvisioningPlan.js",
    "observability:evidence:collect": "node scripts/runCompiledScript.mjs observabilityEvidenceCollect.js",
    "observability:evidence": "node scripts/runCompiledScript.mjs observabilityEvidenceCheck.js",
    "observability:operator-evidence:template": "node scripts/runCompiledScript.mjs observabilityOperatorEvidenceTemplate.js",
    "operator-access:evidence:template": "node scripts/runCompiledScript.mjs operatorAccessEvidenceTemplate.js",
    "operator-access:evidence:collect": "node scripts/runCompiledScript.mjs operatorAccessEvidenceCollect.js",
    "operator-access:evidence": "node scripts/runCompiledScript.mjs operatorAccessEvidenceCheck.js",
    "non-session-credential:evidence:template": "node scripts/runCompiledScript.mjs nonSessionCredentialEvidenceTemplate.js",
    "non-session-credential:evidence:collect": "node scripts/runCompiledScript.mjs nonSessionCredentialEvidenceCollect.js",
    "non-session-credential:evidence": "node scripts/runCompiledScript.mjs nonSessionCredentialEvidenceCheck.js",
    "source-provider:evidence:template": "node scripts/runCompiledScript.mjs sourceProviderEvidenceTemplate.js",
    "source-provider:evidence:collect": "node scripts/runCompiledScript.mjs sourceProviderEvidenceCollect.js",
    "source-provider:evidence": "node scripts/runCompiledScript.mjs sourceProviderEvidenceCheck.js",
    "source-provenance:evidence": "node scripts/runCompiledScript.mjs sourceProviderEvidenceCheck.js",
    "ingress:operator-evidence:template": "node scripts/runCompiledScript.mjs ingressOperatorEvidenceTemplate.js",
    "ingress:evidence:collect": "node scripts/runCompiledScript.mjs ingressEvidenceCollect.js",
    "ingress:evidence": "node scripts/runCompiledScript.mjs ingressEvidenceCheck.js",
    "upgrade-rollback:evidence:template": "node scripts/runCompiledScript.mjs upgradeRollbackDrillEvidenceTemplate.js",
    "upgrade-rollback:evidence": "node scripts/runCompiledScript.mjs upgradeRollbackDrillEvidenceCheck.js",
    "release:target-runtime:evidence:template": "node scripts/runCompiledScript.mjs releaseTargetRuntimeEvidenceTemplate.js",
    "release:target-runtime:evidence:collect": "node scripts/runCompiledScript.mjs releaseTargetRuntimeEvidenceCollect.js",
    "release:target-runtime:evidence": "node scripts/runCompiledScript.mjs releaseTargetRuntimeEvidenceCheck.js",
    "release:evidence:rehearsal-pack": "node scripts/runCompiledScript.mjs releaseEvidenceRehearsalPack.js",
    "release:evidence:pack": "node scripts/runCompiledScript.mjs releaseEvidenceRehearsalPack.js",
    "release:evidence:pack-contract": "node scripts/runCompiledScript.mjs releaseEvidencePackContractCheck.js",
    "release:evidence:gaps": "node scripts/runCompiledScript.mjs releaseEvidenceGapReport.js",
    "release:evidence:gap-report": "node scripts/runCompiledScript.mjs releaseEvidenceGapReport.js",
    "release:evidence:target-run": "node scripts/runCompiledScript.mjs releaseEvidenceTargetRun.js",
    "release:evidence:compose": "node scripts/runCompiledScript.mjs releaseEvidenceBundleCompose.js",
    "release:evidence": "node scripts/runCompiledScript.mjs releaseEvidenceBundleCheck.js",
    "release:evidence:post-promote": "node scripts/runCompiledScript.mjs releasePostPromotionEvidenceCheck.js",
    "release:source:check": "node scripts/runCompiledScript.mjs releaseSourceTreeCheck.js",
    "release:source:cleanup-plan": "node scripts/runCompiledScript.mjs releaseSourceCleanupPlan.js",
    "release:commit:plan": "node scripts/runCompiledScript.mjs releaseCommitReadinessPlan.js",
    "release:dependency:policy": "node scripts/releaseDependencyPolicyCheck.mjs",
    "release:install-profile:check": "node scripts/runCompiledScript.mjs installProfileCheck.js",
    "release:artifact-retention:plan": "node scripts/runCompiledScript.mjs artifactRetentionPlan.js",
    "release:artifact-retention:apply": "node scripts/runCompiledScript.mjs artifactRetentionApply.js",
    "release:artifacts:check": "node scripts/runCompiledScript.mjs releaseArtifactCheck.js",
    "release:artifacts:evidence": "node scripts/runCompiledScript.mjs releaseArtifactCheck.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
